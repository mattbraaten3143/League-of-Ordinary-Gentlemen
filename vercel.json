{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sleeper/:path*", "destination": "https://api.sleeper.app/v1/:path*" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/live.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
